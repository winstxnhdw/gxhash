{
	"extends": ["github>winstxnhdw/renovate"],
	"groupName": null,
	"groupSlug": null,
	"separateMajorMinor": true,
	"ignoreDeps": ["commitizen"],
	"packageRules": [
		{
			"matchCategories": ["python"],
			"matchFileNames": ["pyproject.toml"],
			"enabled": false
		},
		{
			"matchFileNames": [
				".github/**",
				".pre-commit-config.yaml",
				"rust-toolchain.toml",
				"bench/**",
				"tests/**",
				"perf/**"
			],
			"groupName": "development dependencies",
			"groupSlug": "development",
			"semanticCommitType": "internal",
			"semanticCommitScope": "build"
		},
		{
			"matchManagers": ["cargo"],
			"matchFileNames": ["Cargo.toml"],
			"semanticCommitType": "build",
			"semanticCommitScope": null
		},
		{
			"matchManagers": ["cargo"],
			"matchFileNames": ["Cargo.toml"],
			"matchPackageNames": ["pyo3", "pyo3-build-config"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "PyO3",
			"groupSlug": "pyo3"
		},
		{
			"matchUpdateTypes": ["major"],
			"groupName": null,
			"groupSlug": null
		}
	]
}
